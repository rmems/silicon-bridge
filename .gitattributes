# Golden #53 fixtures are recorded as LF SHA-256. Windows checkout
# must not convert them to CRLF or the content hash changes.
tests/golden/** text eol=lf

# libFuzzer seeds are raw frames / f32 bit patterns, not text.
fuzz/corpus/** binary

# Vivado report fixtures (#104): keep LF cases LF on every checkout, and keep
# the CRLF case byte-exact so it really exercises `\r\n` parsing.
tests/fixtures/vivado/** text eol=lf
tests/fixtures/vivado/crlf/** -text
